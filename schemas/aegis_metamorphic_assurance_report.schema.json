{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegissec.example/schemas/aegis_metamorphic_assurance_report.schema.json",
  "title": "AegisSec Step 11E Metamorphic Assurance Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "schema_version",
    "generated_at",
    "catalog",
    "decision_policy",
    "assurance_corpus",
    "input_integrity_checks_before",
    "input_integrity_checks_after",
    "summary",
    "quality_gates",
    "results",
    "violation_relation_ids",
    "harness_error_relation_ids",
    "release_decision",
    "limitations"
  ],
  "properties": {
    "report_id": {"type": "string", "const": "AEG-METAMORPHIC-STEP11E-001"},
    "schema_version": {"type": "string", "const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "catalog": {"$ref": "#/$defs/artifact"},
    "decision_policy": {"$ref": "#/$defs/artifact"},
    "assurance_corpus": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {
          "type": "object",
          "required": ["case_count"],
          "properties": {"case_count": {"type": "integer", "minimum": 1}}
        }
      ]
    },
    "input_integrity_checks_before": {"$ref": "#/$defs/integrityMap"},
    "input_integrity_checks_after": {"$ref": "#/$defs/integrityMap"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_count",
        "critical_relation_count",
        "passed_count",
        "violated_count",
        "blocked_invalid_transformation_count",
        "harness_error_count",
        "critical_relation_pass_rate",
        "sector_neutrality_consistency_rate",
        "danger_escalation_monotonicity_rate",
        "trust_degradation_fail_closed_rate",
        "deadline_monotonicity_rate",
        "review_monotonicity_rate",
        "containment_monotonicity_rate",
        "closure_monotonicity_rate",
        "evidence_removal_no_confidence_gain_rate",
        "trusted_input_integrity_passed",
        "overall_passed"
      ],
      "properties": {
        "relation_count": {"type": "integer", "minimum": 1},
        "critical_relation_count": {"type": "integer", "minimum": 1},
        "passed_count": {"type": "integer", "minimum": 0},
        "violated_count": {"type": "integer", "minimum": 0},
        "blocked_invalid_transformation_count": {"type": "integer", "minimum": 0},
        "harness_error_count": {"type": "integer", "minimum": 0},
        "critical_relation_pass_rate": {"$ref": "#/$defs/rate"},
        "sector_neutrality_consistency_rate": {"$ref": "#/$defs/rate"},
        "danger_escalation_monotonicity_rate": {"$ref": "#/$defs/rate"},
        "trust_degradation_fail_closed_rate": {"$ref": "#/$defs/rate"},
        "deadline_monotonicity_rate": {"$ref": "#/$defs/rate"},
        "review_monotonicity_rate": {"$ref": "#/$defs/rate"},
        "containment_monotonicity_rate": {"$ref": "#/$defs/rate"},
        "closure_monotonicity_rate": {"$ref": "#/$defs/rate"},
        "evidence_removal_no_confidence_gain_rate": {"$ref": "#/$defs/rate"},
        "trusted_input_integrity_passed": {"type": "boolean"},
        "overall_passed": {"type": "boolean"}
      }
    },
    "quality_gates": {
      "type": "array",
      "minItems": 12,
      "items": {"$ref": "#/$defs/gate"}
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/result"}
    },
    "violation_relation_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "harness_error_relation_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "release_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_gate_status", "production_readiness_status", "blocking_reasons"],
      "properties": {
        "stage_gate_status": {"enum": ["PASS", "FAIL"]},
        "production_readiness_status": {"const": "BLOCKED"},
        "blocking_reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "artifact": {
      "type": "object",
      "required": ["relative_path", "sha256"],
      "properties": {
        "catalog_id": {"type": "string"},
        "version": {"type": "string"},
        "relative_path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "case_count": {"type": "integer", "minimum": 1}
      }
    },
    "integrityMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "expected_sha256", "actual_sha256", "safe_path", "exists", "passed"],
        "properties": {
          "relative_path": {"type": "string"},
          "expected_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "actual_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "safe_path": {"type": "boolean"},
          "exists": {"type": "boolean"},
          "passed": {"type": "boolean"}
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "metric", "operator", "threshold", "observed", "passed"],
      "properties": {
        "gate_id": {"type": "string"},
        "metric": {"type": "string"},
        "operator": {"enum": ["gte", "lte", "eq"]},
        "threshold": {"type": ["number", "integer", "boolean"]},
        "observed": {"type": ["number", "integer", "boolean"]},
        "passed": {"type": "boolean"}
      }
    },
    "decision": {
      "type": "object",
      "required": ["action", "priority", "deadline_hours", "human_review_required", "containment_required", "prohibit_closure", "invariants_passed", "matched_rule_ids", "supporting_evidence_ids", "input_affectedness_evidence_count"],
      "properties": {
        "action": {"type": "string"},
        "priority": {"type": "string"},
        "deadline_hours": {"type": "number", "minimum": 0},
        "human_review_required": {"type": "boolean"},
        "containment_required": {"type": "boolean"},
        "prohibit_closure": {"type": "boolean"},
        "invariants_passed": {"type": "boolean"},
        "matched_rule_ids": {"type": "array", "items": {"type": "string"}},
        "supporting_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "input_affectedness_evidence_count": {"type": "integer", "minimum": 0}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "passed", "message"],
      "properties": {
        "code": {"type": "string"},
        "passed": {"type": "boolean"},
        "message": {"type": "string"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_id", "property", "family", "severity", "mode", "control_tags", "baseline_case_id", "transformed_case_id", "expected_changed_paths", "changed_paths", "change_scope_valid", "baseline", "transformed", "checks", "violations", "passed", "outcome", "error", "ephemeral_only"],
      "properties": {
        "relation_id": {"type": "string"},
        "property": {"type": "string"},
        "family": {"type": "string"},
        "severity": {"const": "critical"},
        "mode": {"enum": ["EXACT_EQUALITY", "NON_DECREASING", "FAIL_CLOSED", "NO_AUTOMATION_GAIN", "EVIDENCE_REMOVAL"]},
        "control_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "baseline_case_id": {"type": "string"},
        "transformed_case_id": {"type": "string"},
        "expected_changed_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "changed_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "change_scope_valid": {"type": "boolean"},
        "baseline": {"$ref": "#/$defs/decision"},
        "transformed": {"$ref": "#/$defs/decision"},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
        "violations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "passed": {"type": "boolean"},
        "outcome": {"enum": ["PASSED", "VIOLATED", "BLOCKED_INVALID_TRANSFORMATION", "HARNESS_ERROR"]},
        "error": {"type": ["string", "null"]},
        "ephemeral_only": {"const": true}
      }
    }
  }
}
