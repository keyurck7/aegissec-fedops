{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegissec.local/schemas/aegis-assessment-run-ledger.schema.json",
  "title": "AegisSec Assessment Run Ledger",
  "type": "object",
  "required": [
    "schema_version",
    "assessment_id",
    "created_at",
    "updated_at",
    "run_status",
    "input_reference",
    "stage_plan",
    "stages",
    "events",
    "governance",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^AEG-ASMT-[A-F0-9]{24}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_status": {
      "enum": [
        "CREATED",
        "IN_PROGRESS",
        "AWAITING_HUMAN_REVIEW",
        "BLOCKED",
        "FAILED",
        "COMPLETED"
      ]
    },
    "input_reference": {
      "type": "object",
      "required": [
        "input_id",
        "input_envelope_sha256"
      ],
      "properties": {
        "input_id": {
          "type": "string",
          "minLength": 1
        },
        "input_envelope_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "asset_context_id": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "stage_plan": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "required": [
          "stage_id",
          "order",
          "authority",
          "required",
          "required_dependencies",
          "optional_dependencies"
        ],
        "properties": {
          "stage_id": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "authority": {
            "enum": [
              "AUTHORITATIVE",
              "ADVISORY",
              "HUMAN"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "required_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "optional_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "attempt",
          "started_at",
          "completed_at",
          "reason_code",
          "message",
          "warnings",
          "outputs"
        ],
        "properties": {
          "status": {
            "enum": [
              "PENDING",
              "RUNNING",
              "PASSED",
              "PASSED_WITH_WARNINGS",
              "BLOCKED",
              "FAILED",
              "SKIPPED"
            ]
          },
          "attempt": {
            "type": "integer",
            "minimum": 0
          },
          "started_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "completed_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "reason_code": {
            "type": ["string", "null"]
          },
          "message": {
            "type": ["string", "null"]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "event_id",
          "timestamp",
          "event_type",
          "stage_id",
          "from_status",
          "to_status",
          "actor_type",
          "actor_id",
          "reason_code",
          "message",
          "metadata",
          "previous_event_hash",
          "event_hash"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "event_id": {
            "type": "string",
            "pattern": "^AEG-EVT-[A-F0-9]{20}$"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "event_type": {
            "enum": [
              "RUN_CREATED",
              "STAGE_TRANSITION"
            ]
          },
          "stage_id": {
            "type": ["string", "null"]
          },
          "from_status": {
            "type": ["string", "null"]
          },
          "to_status": {
            "type": ["string", "null"]
          },
          "actor_type": {
            "enum": [
              "SYSTEM",
              "ENGINE",
              "HUMAN",
              "TEST"
            ]
          },
          "actor_id": {
            "type": "string",
            "minLength": 1
          },
          "reason_code": {
            "type": ["string", "null"]
          },
          "message": {
            "type": ["string", "null"]
          },
          "metadata": {
            "type": "object"
          },
          "previous_event_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "event_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "governance": {
      "type": "object",
      "required": [
        "affectedness_authority",
        "policy_authority",
        "model_authority",
        "final_disposition_authority",
        "automated_final_disposition_permitted",
        "production_readiness"
      ],
      "properties": {
        "affectedness_authority": {
          "const": "DETERMINISTIC_ENGINE"
        },
        "policy_authority": {
          "const": "SSVC"
        },
        "model_authority": {
          "const": "ADVISORY_ONLY"
        },
        "final_disposition_authority": {
          "const": "HUMAN"
        },
        "automated_final_disposition_permitted": {
          "const": false
        },
        "production_readiness": {
          "const": "BLOCKED"
        }
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": [
        "algorithm",
        "genesis_hash",
        "event_count",
        "head_event_hash",
        "ledger_sha256"
      ],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "genesis_hash": {
          "type": "string",
          "pattern": "^[0]{64}$"
        },
        "event_count": {
          "type": "integer",
          "minimum": 1
        },
        "head_event_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ledger_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
