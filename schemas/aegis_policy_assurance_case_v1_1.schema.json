{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegissec.example/schemas/aegis-policy-assurance-case-v1.1.0.json",
  "title": "AegisSec Policy Assurance Case v1.1",
  "description": "A reproducible policy assurance scenario supporting the original Step 9 matrix and targeted Step 11A policy-rule coverage cases.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "pair_id",
    "case_index",
    "sector_label",
    "counterfactual_key",
    "differing_fields",
    "scenario",
    "expected",
    "tags"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "case_id": {
      "type": "string",
      "pattern": "^AEG-ASR-[0-9]{3}-(HC|DL)$"
    },
    "pair_id": {
      "type": "string",
      "pattern": "^PAIR-[0-9]{3}$"
    },
    "case_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 130
    },
    "sector_label": {
      "type": "string",
      "enum": [
        "healthcare",
        "defence_logistics"
      ]
    },
    "counterfactual_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "differing_fields": {
      "type": "array",
      "const": [
        "sector_context.primary_sector"
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affectedness_profile",
        "operational_profile",
        "affectedness",
        "trust",
        "asset_overrides",
        "intelligence_overrides",
        "component_overrides"
      ],
      "properties": {
        "affectedness_profile": {
          "type": "string",
          "enum": [
            "affected",
            "probably_affected",
            "unknown",
            "probably_not_affected",
            "fixed"
          ]
        },
        "operational_profile": {
          "type": "string",
          "enum": [
            "baseline",
            "kev_listed",
            "active_exploitation",
            "internet_exposed",
            "exposure_unknown",
            "catastrophic_impact",
            "severe_impact",
            "mission_essential",
            "high_criticality",
            "critical_cvss",
            "no_fix_available",
            "trust_blocked",
            "trust_warnings",
            "known_exploitation",
            "runtime_reachable",
            "high_impact",
            "epss_missing_affected"
          ]
        },
        "affectedness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "confidence",
            "supporting_evidence_ids"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "affected",
                "probably_affected",
                "unknown",
                "probably_not_affected",
                "fixed"
              ]
            },
            "confidence": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "supporting_evidence_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^AEG-EVD-[A-Z0-9][A-Z0-9._-]{5,99}$"
              }
            }
          }
        },
        "trust": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "aggregate_score"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "ACCEPT",
                "ACCEPT_WITH_WARNINGS",
                "QUARANTINE",
                "REJECT"
              ]
            },
            "aggregate_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "asset_overrides": {
          "type": "object",
          "additionalProperties": true
        },
        "intelligence_overrides": {
          "type": "object",
          "additionalProperties": true
        },
        "component_overrides": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "priority",
        "deadline_hours",
        "human_review_required",
        "containment_required",
        "prohibit_closure",
        "invariants_must_pass"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "TRACK",
            "TRACK_STAR",
            "ATTEND",
            "ACT",
            "HOLD"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "INFORMATIONAL",
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL",
            "EMERGENCY"
          ]
        },
        "deadline_hours": {
          "type": "number",
          "minimum": 0
        },
        "human_review_required": {
          "type": "boolean"
        },
        "containment_required": {
          "type": "boolean"
        },
        "prohibit_closure": {
          "type": "boolean"
        },
        "invariants_must_pass": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "tags": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    }
  }
}
