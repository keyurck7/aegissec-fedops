{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegissec.example/schemas/aegis-fairness-robustness-report-v1.0.0.json",
  "title": "AegisSec Fairness and Robustness Evaluation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "source_assurance_report",
    "evaluator",
    "decision_policy",
    "summary",
    "exact_match_metrics",
    "safety_metrics",
    "abstention_metrics",
    "counterfactual_metrics",
    "monotonicity_metrics",
    "subgroup_metrics",
    "rule_coverage",
    "bootstrap",
    "quality_gates",
    "release_decision",
    "limitations",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "report_id": {
      "type": "string",
      "pattern": "^AEG-EVAL-[A-Z0-9][A-Z0-9._-]{5,149}$"
    },
    "source_assurance_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "sha256",
        "case_count",
        "pair_count"
      ],
      "properties": {
        "relative_path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "pair_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "evaluator_version",
        "policy_sha256"
      ],
      "properties": {
        "policy_id": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "evaluator_version": {
          "type": "string"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "pair_count",
        "stage_gate_passed",
        "production_readiness",
        "failed_quality_gate_count"
      ],
      "properties": {
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "pair_count": {
          "type": "integer",
          "minimum": 1
        },
        "stage_gate_passed": {
          "type": "boolean"
        },
        "production_readiness": {
          "type": "boolean"
        },
        "failed_quality_gate_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "exact_match_metrics": {
      "$ref": "#/$defs/objectMetricGroup"
    },
    "safety_metrics": {
      "$ref": "#/$defs/objectMetricGroup"
    },
    "abstention_metrics": {
      "$ref": "#/$defs/objectMetricGroup"
    },
    "counterfactual_metrics": {
      "$ref": "#/$defs/objectMetricGroup"
    },
    "monotonicity_metrics": {
      "$ref": "#/$defs/objectMetricGroup"
    },
    "subgroup_metrics": {
      "type": "object"
    },
    "rule_coverage": {
      "$ref": "#/$defs/objectMetricGroup"
    },
    "bootstrap": {
      "$ref": "#/$defs/objectMetricGroup"
    },
    "quality_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "metric",
          "operator",
          "threshold",
          "observed",
          "passed",
          "release_blocking"
        ],
        "properties": {
          "gate_id": {
            "type": "string"
          },
          "metric": {
            "type": "string"
          },
          "operator": {
            "type": "string",
            "enum": [
              "gte",
              "lte",
              "eq"
            ]
          },
          "threshold": {},
          "observed": {},
          "passed": {
            "type": "boolean"
          },
          "release_blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "release_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_gate_status",
        "production_readiness_status",
        "blocking_reasons",
        "scope_limitations"
      ],
      "properties": {
        "stage_gate_status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "production_readiness_status": {
          "type": "string",
          "enum": [
            "READY",
            "BLOCKED"
          ]
        },
        "blocking_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "version",
        "sha256"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "$defs": {
    "objectMetricGroup": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
