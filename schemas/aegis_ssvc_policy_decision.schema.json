{
  "$defs": {
    "decision_point": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "mapping_rule_id": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "source_feature_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "RESOLVED",
            "UNRESOLVED"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "key",
        "status",
        "source_feature_paths",
        "reason_codes",
        "mapping_rule_id"
      ],
      "type": "object"
    },
    "outcome": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "ssvc:DSOI:1.0.0"
        },
        "key": {
          "enum": [
            "D",
            "S",
            "O",
            "I"
          ]
        },
        "name": {
          "enum": [
            "DEFER",
            "SCHEDULED",
            "OUT_OF_CYCLE",
            "IMMEDIATE"
          ]
        },
        "rank": {
          "maximum": 3,
          "minimum": 0,
          "type": "integer"
        },
        "reason_code": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "key",
        "name",
        "rank",
        "reason_code"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "$id": "https://aegissec.example/schemas/aegis_ssvc_policy_decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audit": {
