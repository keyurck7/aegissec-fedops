{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegissec.example/schemas/aegis_affectedness_adjudication.schema.json",
  "title": "AegisSec Evidence-Governed Affectedness Adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "generated_at",
    "policy",
    "inputs",
    "target",
    "trust",
    "technical_assessment",
    "adjudication",
    "runtime_context",
    "conflicts",
    "quality_gates",
    "release_decision",
    "audit"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "relative_path", "sha256"],
      "properties": {
        "record_id": {"type": "string", "minLength": 3, "maxLength": 300},
        "relative_path": {"type": "string", "minLength": 1, "maxLength": 2000},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "package_name", "ecosystem", "version", "purl"],
      "properties": {
        "component_id": {"type": "string", "minLength": 3, "maxLength": 300},
        "package_name": {"type": "string", "minLength": 1, "maxLength": 500},
        "ecosystem": {"type": "string", "minLength": 1, "maxLength": 100},
        "version": {"type": "string", "minLength": 1, "maxLength": 200},
        "purl": {"type": ["string", "null"], "maxLength": 1000}
      }
    },
    "qualityGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "metric", "observed", "expected", "pass"],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^M12C-[A-Z0-9-]+$"},
        "metric": {"type": "string", "minLength": 2, "maxLength": 300},
        "observed": {},
        "expected": {},
        "pass": {"type": "boolean"}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "blocking", "message", "evidence"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "blocking": {"type": "boolean"},
        "message": {"type": "string", "minLength": 3, "maxLength": 2000},
        "evidence": {"type": "object"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_id": {"type": "string", "pattern": "^AEG-AFA-[A-F0-9]{24}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "version", "engine_version", "sha256"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 3, "maxLength": 300},
        "version": {"type": "string", "minLength": 1, "maxLength": 100},
        "engine_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_intelligence", "asset_context", "component_evidence", "runtime_context"],
      "properties": {
        "canonical_intelligence": {"$ref": "#/$defs/reference"},
        "asset_context": {"$ref": "#/$defs/reference"},
        "component_evidence": {"$ref": "#/$defs/reference"},
        "runtime_context": {"$ref": "#/$defs/reference"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cve_id", "asset_id", "component"],
      "properties": {
        "cve_id": {"type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"},
        "asset_id": {"type": "string", "minLength": 3, "maxLength": 300},
        "component": {"$ref": "#/$defs/component"}
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_evidence", "canonical_intelligence", "combined"],
      "properties": {
        "component_evidence": {"type": "object"},
        "canonical_intelligence": {"type": "object"},
        "combined": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "aggregate_score", "reason_codes"],
          "properties": {
            "action": {"enum": ["ACCEPT", "ACCEPT_WITH_WARNINGS", "QUARANTINE", "REJECT"]},
            "aggregate_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "reason_codes": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
            }
          }
        }
      }
    },
    "technical_assessment": {"type": "object"},
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "technical_status",
        "confidence",
        "determination_basis",
        "reason_codes",
        "supporting_evidence_ids",
        "uncertainty_factors",
        "human_review_required",
        "closure_prohibited"
      ],
      "properties": {
        "status": {"enum": ["AFFECTED", "PROBABLY_AFFECTED", "NOT_AFFECTED", "UNKNOWN", "CONFLICTED"]},
        "technical_status": {"enum": ["affected", "probably_affected", "unknown", "probably_not_affected", "not_affected", "fixed"]},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "determination_basis": {"type": "string", "minLength": 3, "maxLength": 300},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
        },
        "supporting_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 300}
        },
        "uncertainty_factors": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 2000}
        },
        "human_review_required": {"type": "boolean"},
        "closure_prohibited": {"type": "boolean"}
      }
    },
    "runtime_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presence", "reachability", "configuration", "affectedness_semantics"],
      "properties": {
        "presence": {"enum": ["PRESENT", "ABSENT", "UNKNOWN"]},
        "reachability": {"enum": ["REACHABLE", "NOT_REACHABLE", "UNKNOWN"]},
        "configuration": {"enum": ["VULNERABLE", "MITIGATED", "UNKNOWN"]},
        "affectedness_semantics": {"type": "string", "minLength": 20, "maxLength": 2000}
      }
    },
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
    "quality_gates": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/qualityGate"}},
    "release_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_gate", "policy_eligibility", "production_readiness", "blocking_reasons"],
      "properties": {
        "stage_gate": {"enum": ["PASS", "FAIL"]},
        "policy_eligibility": {"enum": ["ELIGIBLE", "REVIEW_REQUIRED", "BLOCKED"]},
        "production_readiness": {"const": "BLOCKED"},
        "blocking_reasons": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 3, "maxLength": 2000}
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_json_sha256", "input_hashes", "deterministic_report_id"],
      "properties": {
        "canonical_json_sha256": {"$ref": "#/$defs/sha256"},
        "input_hashes": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "deterministic_report_id": {"const": true}
      }
    }
  }
}
